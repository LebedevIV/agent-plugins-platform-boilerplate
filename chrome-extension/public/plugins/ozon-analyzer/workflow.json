{
  "name": "ozon_analyzer",
  "description": "Анализатор товаров Ozon с проверкой соответствия описания и состава",
  "steps": [
    {
      "id": "analyze",
      "description": "Анализ продукта Ozon",
      "tool": "python.analyze_ozon_product",
      "inputs": { "page_html": "{{input.pageHtml}}" }
    },
    {
      "id": "deep-analysis",
      "tool": "python.perform_deep_analysis",
      "run_if": "{{steps.analyze.output.deep_analysis_offer.available}} == true",
      "inputs": {
        "description": "{{steps.analyze.output.description}}",
        "composition": "{{steps.analyze.output.composition}}"
      }
    }
  ]
}