curl -X POST "https://generativelanguage.googleapis.com/v1/models/gemini-2.5-pro:generateContent"
  -H "x-goog-api-key: $GEMINI_API_KEY" \
  -H "Content-Type: application/json" \
  -d '{
    "contents": [
      {
        "parts": [
          {
            "text": "$prompt"
          }
        ]
      }
    ]
  }'